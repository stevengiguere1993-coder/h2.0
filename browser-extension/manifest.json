{
  "manifest_version": 3,
  "name": "Horizon h2.0 Helper",
  "version": "1.3.0",
  "description": "Rôle d'évaluation Montréal, Centris et projets QuickBooks pour Horizon h2.0",
  "permissions": ["storage", "activeTab", "tabs", "alarms"],
  "host_permissions": [
    "https://montreal.ca/*",
    "https://www.centris.ca/*",
    "https://*.qbo.intuit.com/*",
    "http://localhost/*",
    "https://*.onrender.com/*",
    "https://*.horizonimmo.ca/*",
    "https://immohorizon.com/*",
    "https://*.immohorizon.com/*",
    "https://immohorizon.ca/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://montreal.ca/role-evaluation-fonciere*",
        "https://montreal.ca/info-recherche/role-evaluation-fonciere*"
      ],
      "js": ["content-evalweb.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.centris.ca/fr/*",
        "https://www.centris.ca/en/*"
      ],
      "js": ["content-centris.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.qbo.intuit.com/*"],
      "js": ["content-qbo.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://localhost:*/*",
        "https://*.onrender.com/*",
        "https://immohorizon.com/*",
        "https://*.immohorizon.com/*",
        "https://immohorizon.ca/*"
      ],
      "js": ["content-h20.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Horizon h2.0 Helper"
  }
}
